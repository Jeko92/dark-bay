PORT='<Declare app port here>'
DATABASE_URL='<Postgres connection string, e.g. postgres://user:password@host:5432/dbname>'
DATABASE_SSL='<Optional. Set to "true" only for an external Postgres connection (e.g. from outside Render). Leave unset for Render internal connections or local docker-compose.>'
DATABASE_CA_CERT='<Optional, only relevant when DATABASE_SSL=true. PEM text of the provider'"'"'s CA bundle, used to verify the server certificate.>'
DATABASE_SSL_INSECURE='<Optional, only relevant when DATABASE_SSL=true and DATABASE_CA_CERT is not set. Set to "true" to skip certificate verification — an explicit, deliberate downgrade, not a default.>'
JWT_SECRET='<Long random string used to sign/verify JWTs, e.g. `openssl rand -hex 64` — never commit the real value>'
BCRYPT_SALT_ROUNDS='<Optional. bcrypt cost factor for hashing passwords. Defaults to 12 if unset.>'
DEFAULT_AUCTION_DURATION_DAYS='<Currently default is 3 days if no endDate is provided>'
